<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="WinClicker.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WinClicker.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="using:WinClicker.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewModels:SettingsViewModel}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <x:Double x:Key="SettingsCardSpacing">4</x:Double>
            <Style
                x:Key="SettingsSectionHeaderTextBlockStyle"
                BasedOn="{StaticResource BodyStrongTextBlockStyle}"
                TargetType="TextBlock">
                <Style.Setters>
                    <Setter Property="Margin" Value="1,30,0,6" />
                </Style.Setters>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            x:Name="SettingsTitle"
            x:Uid="SettingsView_Title"
            Grid.Row="0"
            Margin="24,8,24,16"
            HorizontalAlignment="Stretch"
            AutomationProperties.HeadingLevel="Level1"
            Style="{StaticResource SubtitleTextBlockStyle}" />

        <ScrollView
            Grid.Row="1"
            HorizontalAlignment="Stretch"
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollBarVisibility="Auto">
            <StackPanel
                Padding="24,0,24,24"
                HorizontalAlignment="Stretch"
                Orientation="Vertical"
                Spacing="{StaticResource SettingsCardSpacing}">
                <StackPanel.ChildrenTransitions>
                    <TransitionCollection>
                        <RepositionThemeTransition IsStaggeringEnabled="False" />
                    </TransitionCollection>
                </StackPanel.ChildrenTransitions>

                <TextBlock
                    x:Uid="SettingsView_AppearanceSectionHeader"
                    Margin="1,14,0,6"
                    Style="{StaticResource BodyStrongTextBlockStyle}" />

                <controls:SettingsExpander x:Uid="SettingsView_AppThemeSettingsExpander">
                    <controls:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE790;" />
                    </controls:SettingsExpander.HeaderIcon>

                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard>
                            <RadioButtons SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}">
                                <RadioButton x:Uid="SettingsView_AppThemeSettingsExpander_LightRadioButton" />
                                <RadioButton x:Uid="SettingsView_AppThemeSettingsExpander_DarkRadioButton" />
                                <RadioButton x:Uid="SettingsView_AppThemeSettingsExpander_UseSystemSettingRadioButton" />
                            </RadioButtons>
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                <TextBlock x:Uid="SettingsView_AboutSectionHeader" Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />

                <controls:SettingsExpander x:Uid="SettingsView_WinClickerSettingsExpander" Header="WinClicker">
                    <controls:SettingsExpander.HeaderIcon>
                        <BitmapIcon ShowAsMonochrome="False" UriSource="/Assets/AppIcon.png" />
                    </controls:SettingsExpander.HeaderIcon>

                    <TextBlock
                        Margin="0,8,0,0"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        IsTextSelectionEnabled="True"
                        Text="2.0.0" />

                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard>
                            <StackPanel>
                                <HyperlinkButton
                                    x:Uid="SettingsView_WinClickerSettingsExpander_GitHubRepositoryHyperlinkButton"
                                    Margin="-12,0,0,0"
                                    NavigateUri="https://github.com/randomguy-2650/WinClicker"
                                    ToolTipService.ToolTip="https://github.com/randomguy-2650/WinClicker" />
                                <HyperlinkButton
                                    x:Uid="SettingsView_WinClickerSettingsExpander_MITLicenseHyperlinkButton"
                                    Margin="-12,0,0,0"
                                    NavigateUri="https://github.com/randomguy-2650/WinClicker/tree/main/LICENSE.md"
                                    ToolTipService.ToolTip="https://github.com/randomguy-2650/WinClicker/tree/main/LICENSE.md" />
                                <HyperlinkButton
                                    x:Uid="SettingsView_WinClickerSettingsExpander_ThirdPartyNoticesHyperlinkButton"
                                    Margin="-12,0,0,0"
                                    NavigateUri="https://github.com/randomguy-2650/WinClicker/tree/main/THIRD-PARTY-NOTICES.md"
                                    ToolTipService.ToolTip="https://github.com/randomguy-2650/WinClicker/tree/main/THIRD-PARTY-NOTICES.md" />
                            </StackPanel>
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>
            </StackPanel>
        </ScrollView>
    </Grid>
</UserControl>
