<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <UseWinUI>true</UseWinUI>
        <RootNamespace>WinClicker</RootNamespace>
        <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
        <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
        <EnableWindowsTargeting>true</EnableWindowsTargeting>
        <LangVersion>preview</LangVersion>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <Version>2.0.0</Version>
        <FileVersion>2.0.0.0</FileVersion>
        <AssemblyVersion>2.0.0.0</AssemblyVersion>
        <Company>WinClicker</Company>
        <Product>WinClicker</Product>
        <Description>WinClicker is a high‐performance, lightweight autoclicker designed for Windows 10/11.</Description>
        <Copyright>© 2026 randomguy-2650 and his contributors</Copyright>
        <AssemblyName>WinClicker</AssemblyName>
        <AssemblyTitle>WinClicker</AssemblyTitle>
        <Title>WinClicker</Title>
        <DefaultLanguage>en</DefaultLanguage>
        <SatelliteResourceLanguages>en;en-GB;de</SatelliteResourceLanguages>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <ApplicationIcon>Assets\appicon.ico</ApplicationIcon>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <WindowsPackageType>None</WindowsPackageType>
        <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
        <SelfContained>true</SelfContained>
        <Platforms>x64;ARM64</Platforms>
        <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
        <PublishProfile>win-$(Platform).pubxml</PublishProfile>
        <PublishSingleFile>true</PublishSingleFile>
        <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
        <EnableMsixTooling>true</EnableMsixTooling>
    </PropertyGroup>

    <PropertyGroup>
        <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
        <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
        <PublishTrimmed Condition="'$(Configuration)' == 'Debug'">False</PublishTrimmed>
        <PublishTrimmed Condition="'$(Configuration)' != 'Debug'">True</PublishTrimmed>
        <PublishAot Condition="'$(Configuration)' == 'Debug'">True</PublishAot>
        <PublishAot Condition="'$(Configuration)' != 'Debug'">True</PublishAot>
        <IncludeNativeLibrariesForSelfExtract Condition="'$(Configuration)' != 'Debug'">true</IncludeNativeLibrariesForSelfExtract>
        <IncludeAllContentForSelfExtract Condition="'$(Configuration)' != 'Debug'">true</IncludeAllContentForSelfExtract>
        <DebugSymbols Condition="'$(Configuration)' != 'Debug'">false</DebugSymbols>
        <DebugType Condition="'$(Configuration)' != 'Debug'">none</DebugType>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
        <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.251219" />
        <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
        <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.4.0" />
        <PackageReference Include="Microsoft.Xaml.Behaviors.WinUI.Managed" Version="3.0.1" />
        <PackageReference Include="WinUIEx" Version="2.9.3" />
    </ItemGroup>

    <Target Name="CopyLegalNoticesToPublish" AfterTargets="Publish">
        <Copy SourceFiles="$(MSBuildProjectDirectory)\..\LICENSE.md" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
        <Copy SourceFiles="$(MSBuildProjectDirectory)\..\THIRD-PARTY-NOTICES.md" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
    </Target>

    <Target Name="HideAndCleanupPublishFiles" AfterTargets="Publish" DependsOnTargets="CopyLegalNoticesToPublish">
        <Exec Condition="'$(Configuration)' == 'Release'" Command="powershell -Command &quot;Get-ChildItem -Path '$(PublishDir)' -Recurse -Exclude 'WinClicker.exe', 'THIRD-PARTY-NOTICES.md', 'LICENSE.md' | ForEach-Object { $_.Attributes = 'Hidden' }&quot;" />
        <Exec Condition="'$(Configuration)' == 'Release'" Command="powershell -Command &quot;$p = Join-Path '$(PublishDir)' 'WinClicker.pdb'; if (Test-Path $p) { 1..3 | ForEach-Object { Start-Sleep -Milliseconds 300; try { Remove-Item -Path $p -Force -ErrorAction Stop; break } catch {} } }&quot;" />
    </Target>
</Project>
